# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finance_snapshot

# 32-byte key for AES-256-GCM signature encryption (base64 or 64-char hex).
# Generate with: openssl rand -base64 32
# Changing it makes existing signatures unreadable.
SIGNATURE_KEY=

# Set to "false" to stop new sign-ups.
SIGNUP_ENABLED=true

# Canonical public URL, used for the sitemap, robots.txt and metadata (no trailing slash).
# On Vercel it falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address shown on the Contact, Privacy and Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=shubhamspatilnbr@gmail.com
