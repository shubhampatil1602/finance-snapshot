# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finance_snapshot

# 32-byte key for AES-256-GCM signature encryption (base64 or 64-char hex).
# Generate with: openssl rand -base64 32
# Changing it makes existing signatures unreadable.
SIGNATURE_KEY=

# Set to "false" to stop new sign-ups.
SIGNUP_ENABLED=true
